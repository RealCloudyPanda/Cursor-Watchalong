# ── apps/server ───────────────────────────────────────────────
PORT=8787
# Cloudflare Realtime TURN (dash.cloudflare.com → Realtime → TURN). Empty = public STUN only.
CF_TURN_KEY_ID=
CF_TURN_API_TOKEN=
# Comma-separated origins allowed to open the WebSocket, e.g.
# https://watch.example.com,chrome-extension://<your-extension-id>
ALLOWED_ORIGINS=
ROOMS_PER_IP_PER_MIN=10
MAX_ROOMS=2000

# ── apps/extension (copy to apps/extension/.env.production for store builds) ──
WXT_PUBLIC_ORIGIN=https://cursor-watchalong.fly.dev
WXT_WS_URL=wss://cursor-watchalong.fly.dev/ws
